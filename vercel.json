{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), magnetometer=(), gyroscope=(), accelerometer=()"
        },
        {
          "key": "Content-Security-Policy-Report-Only",
          "value": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: blob: https://uzkwfudbrozjzjtcjfry.supabase.co https://observatorirenovables.cat https://transicioenergeticajusta.cat; connect-src 'self' https://uzkwfudbrozjzjtcjfry.supabase.co wss://uzkwfudbrozjzjtcjfry.supabase.co; font-src 'self'; media-src 'self' blob:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
        }
      ]
    },
    {
      "source": "/area-privada/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/equip",
      "destination": "/area-privada/",
      "statusCode": 302
    },
    {
      "source": "/equip/",
      "destination": "/area-privada/",
      "statusCode": 302
    },
    {
      "source": "/projecte.html",
      "destination": "/qui-som.html#el-projecte",
      "statusCode": 301
    },
    {
      "source": "/agenda.html",
      "destination": "/actualitat.html#agenda",
      "statusCode": 301
    },
    {
      "source": "/noticies.html",
      "destination": "/actualitat.html#noticies",
      "statusCode": 301
    },
    {
      "source": "/entitats.html",
      "destination": "/recursos.html#entitats",
      "statusCode": 301
    },
    {
      "source": "/eines.html",
      "destination": "/recursos.html#eines",
      "statusCode": 301
    }
  ]
}
